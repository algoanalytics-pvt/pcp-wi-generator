# Template for LOCAL use: copy to `.env` (Docker, next to docker-compose.yml)
# or `backend/.env` (local dev) and fill in the real key. `.env` is git-ignored
# and is never baked into the image.
#
# On the EC2 host you do NOT create this by hand: the deploy workflow writes
# `.env` from the GitHub repo secrets on every deploy.

# OpenAI — the only model used is gpt-5.6-luna (see backend/llm_client.py)
OPENAI_API_KEY=
