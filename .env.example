# Template for LOCAL use: copy to `.env` next to docker-compose.yml and fill in
# real values. `.env` is git-ignored and is never baked into the image —
# docker-compose reads it at run time via `env_file`.
#
# On the EC2 host you do NOT create this by hand: the deploy workflow writes
# `.env` from the GitHub repo secrets of the same names on every deploy.
#
# At least ONE provider key must be set, or /api/generate returns
# "No API key found". backend/main.py picks the first provider (in the order
# below, as declared in backend/llm_client.py PROVIDERS) that has a key set,
# unless the request names an explicit model.

# Mistral — models: mistral-large-latest, mistral-small-latest
MISTRAL_API_KEY=

# Groq — models: llama-3.1-70b, llama-3.1-8b, qwen-2.5-72b
GROQ_API_KEY=

# OpenAI — models: gpt-4o, gpt-4o-mini
OPENAI_API_KEY=

# Together — models: qwen-2.5-72b, llama-3.1-70b, deepseek-r1
TOGETHER_API_KEY=
